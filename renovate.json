{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "schedule": ["* 0-8 * * 1"],
  "automerge": true,
  "automergeStrategy": "squash",
  "rangeStrategy": "update-lockfile",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  }
}
